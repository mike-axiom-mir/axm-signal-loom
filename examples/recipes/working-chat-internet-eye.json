{
  "version": "axm.signal-machine.recipe/0.5",
  "name": "working-chat + internet weather + simulation",
  "inputs": [
    {
      "organ_id": "working-chat",
      "label": "working chat motifs",
      "payload": {
        "themes": [
          "metal rain",
          "repair",
          "tiny impossible garden"
        ],
        "weights": [
          0.8,
          0.55,
          0.7
        ]
      },
      "weight": 1,
      "provenance": "example working-chat packet"
    },
    {
      "organ_id": "internet-eye",
      "label": "ambient public internet influence",
      "payload": {
        "matches": [
          {
            "port": 443,
            "transport": "tcp",
            "location": {
              "country_code": "NL"
            },
            "product": "nginx",
            "org": "example-a",
            "data": "banner-a",
            "ssl": {
              "enabled": true
            }
          },
          {
            "port": 22,
            "transport": "tcp",
            "location": {
              "country_code": "DE"
            },
            "product": "OpenSSH",
            "org": "example-b",
            "data": "banner-b"
          }
        ]
      },
      "weight": 0.7,
      "provenance": "example Shodan-compatible fixture; not live retrieval"
    },
    {
      "organ_id": "simulation-state",
      "label": "world pressure",
      "payload": {
        "storm": 0.65,
        "crowding": 0.42,
        "motion": 0.81
      },
      "weight": 0.45,
      "provenance": "example local simulation fixture"
    }
  ]
}
